# Magpie: configuration
#
# Copy this file to .env and adjust it. docker-compose.yml passes every value to the app.
# .env is ignored by git, so secrets (client secrets) are safe there; never put them in this file.
# Commented-out lines show the default.

# ---- Container ---------------------------------------------------------------------------------

# Time zone (log timestamps), e.g. Europe/Berlin or America/Winnipeg.
TZ=UTC
# Port on the host the app is published on (http://<host>:8085).
MAGPIE_PORT=8085

# ---- Encryption (required) ---------------------------------------------------------------------
# Encrypts the database and all stored files in ./data. Without this key the data cannot be read:
# not by anyone who gets a copy of ./data, and not by the app either. Keep a copy of the key
# somewhere safe outside this server; if it is lost, so are the notes.
# Generate one with:  openssl rand -hex 32   (at least 32 characters). Never change it later.
ENCRYPTION_KEY=
# Instead of the key itself: a file holding it (e.g. a Docker secret, /run/secrets/magpie_key).
#ENCRYPTION_KEY_FILE=

# ---- Accounts ----------------------------------------------------------------------------------

# Public sign-up. When false, only the very first account (the admin) can register;
# admins create everyone else on the Users page.
ALLOW_REGISTRATION=true
# Public URL of the app. Needed for sign-in with GitHub/OIDC; with https:// session
# cookies are marked Secure.
BASE_URL=https://magpie.example.com
# Force the Secure cookie flag on or off (default: on when BASE_URL starts with https://).
#COOKIE_SECURE=
# Login session lifetime in days (sliding).
SESSION_DAYS=30
# true behind a reverse proxy (Traefik, Caddy, nginx, …), so client IPs are correct.
TRUST_PROXY=false

# ---- Notes -------------------------------------------------------------------------------------

# Items in the trash are deleted permanently after this many days.
TRASH_DAYS=30

# ---- Link previews -----------------------------------------------------------------------------

# Fetch page information for link notes. false: never contact linked sites.
LINK_PREVIEWS=true
# Allow previews of LAN addresses (192.168.x.x, 10.x, localhost, …), e.g. your own
# self-hosted services. Off by default so users can't probe your internal network.
LINK_PREVIEW_ALLOW_LAN=false
# FlareSolverr (https://github.com/FlareSolverr/FlareSolverr) for sites that block link
# previews or only show prices in a browser. Empty: not used.
FLARESOLVERR_URL=
#FLARESOLVERR_URL=http://192.168.1.10:8191

# ---- Sign in with GitHub (optional; needs BASE_URL) --------------------------------------------
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App,
# "Authorization callback URL": <BASE_URL>/api/auth/sso/github/callback
# Empty values leave it switched off.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only for GitHub Enterprise Server:
#GITHUB_URL=https://github.com
#GITHUB_API_URL=https://api.github.com

# ---- Sign in with OpenID Connect (optional; needs BASE_URL) ------------------------------------
# Authentik, Keycloak, Authelia, Google, Microsoft Entra ID, …: register a client with the
# redirect URI <BASE_URL>/api/auth/sso/oidc/callback. Empty values leave it switched off.

# e.g. https://auth.example.com/application/o/magpie/
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Empty for a public client (PKCE only).
OIDC_CLIENT_SECRET=
# Name on the button ("Sign in with …").
OIDC_NAME=Single sign-on
OIDC_SCOPES=openid profile email

# ---- Logging -----------------------------------------------------------------------------------

# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# ---- Set by the Docker image; only change these when running without Docker -------------------

#HOST=0.0.0.0
#PORT=3000
#DATA_DIR=/data
#DATABASE_PATH=/data/app.db
#WEB_DIST=
# Interval of keep-alive messages on the live-update stream, in milliseconds.
#LIVE_HEARTBEAT_MS=25000
